  <a class="wa-float" href="https://wa.me/5549991037319?text=Olá,%20vi%20a%20apresentação%20do%20McLaren%20Artura%202026%20no%20site%20da%20Kist%20Motors%20e%20quero%20mais%20informações.">📲 Falar com a Kist Motors</a>

  <div class="lightbox" id="lightbox">
    <div class="lightbox-top">
      <div id="lightboxTitle">Vista principal</div>
      <div class="lightbox-controls">
        <button class="icon-btn" onclick="zoomOut()" aria-label="Diminuir zoom">−</button>
        <button class="icon-btn" onclick="zoomIn()" aria-label="Aumentar zoom">+</button>
        <button class="icon-btn" onclick="resetZoom()" aria-label="Resetar zoom">⟲</button>
        <button class="icon-btn" onclick="closeLightbox()" aria-label="Fechar">✕</button>
      </div>
    </div>
    <div class="lightbox-stage" id="lightboxStage">
      <img id="lightboxImage" src="data:image/jpeg;base64," alt="Vista principal">
    </div>
    <div class="hint">Toque na foto para ampliar. No modo aberto, use + e − para zoom.</div>
  </div>

  <script>
    const images = ['data:image/jpeg;base64,', 'data:image/jpeg;base64,', 'data:image/jpeg;base64,', 'data:image/jpeg;base64,', 'data:image/jpeg;base64,', 'data:image/jpeg;base64,'];
    const titles = ['Vista principal', 'Traseira', 'Cockpit em Alcântara', 'Entrada de ar lateral', 'Rodas e freios', 'Porta dihedral aberta'];
    let current = 0;
    let zoom = 1;

    const mainImage = document.getElementById('mainImage');
    const thumbs = Array.from(document.querySelectorAll('.thumb'));
    const dotsWrap = document.getElementById('dots');
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightboxImage');
    const lightboxTitle = document.getElementById('lightboxTitle');

    function renderDots() {
      dotsWrap.innerHTML = images.map((_, i) => `<span class="dot ${i === current ? 'active' : ''}"></span>`).join('');
    }

    function setSlide(index) {
      current = index;
      mainImage.src = images[index];
      mainImage.alt = titles[index];
      thumbs.forEach((el, i) => el.classList.toggle('active', i === index));
      renderDots();
      lightboxImage.src = images[index];
      lightboxImage.alt = titles[index];
      lightboxTitle.textContent = titles[index];
      resetZoom();
    }

    function prevSlide() {
      setSlide((current - 1 + images.length) % images.length);
    }

    function nextSlide() {
      setSlide((current + 1) % images.length);
    }

    function openLightbox() {
      lightbox.classList.add('open');
      lightboxImage.src = images[current];
      lightboxImage.alt = titles[current];
      lightboxTitle.textContent = titles[current];
      resetZoom();
    }

    function closeLightbox() {
      lightbox.classList.remove('open');
    }

    function applyZoom() {
      lightboxImage.style.transform = `scale(${zoom})`;
    }

    function zoomIn() {
      zoom = Math.min(zoom + 0.4, 4);
      applyZoom();
    }

    function zoomOut() {
      zoom = Math.max(zoom - 0.4, 1);
      applyZoom();
    }

    function resetZoom() {
      zoom = 1;
      applyZoom();
    }

    lightboxImage.addEventListener('dblclick', () => {
      zoom = zoom === 1 ? 2 : 1;
      applyZoom();
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextSlide();
      if (e.key === 'ArrowLeft') prevSlide();
    });

    renderDots();
  </script>
</body>
