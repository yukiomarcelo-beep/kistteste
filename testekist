          <button class="nav-btn left" onclick="event.stopPropagation(); prevSlide()" aria-label="Anterior">‹</button>
          <img id="mainImage" class="main-image" src="data:image/jpeg;base64," alt="Vista principal">
          <button class="nav-btn right" onclick="event.stopPropagation(); nextSlide()" aria-label="Próxima">›</button>

