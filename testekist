<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kist Motors — McLaren Artura 2026</title>
  <meta name="description" content="Apresentação interativa premium do McLaren Artura 2026 da Kist Motors." />
  <meta name="theme-color" content="#050505" />
  <style>
    :root {
      --bg:#050505;
      --bg-soft:#0b0b0b;
      --panel:#0d0d0d;
      --line:rgba(255,255,255,.10);
      --line-soft:rgba(255,255,255,.06);
      --text:#f4efe8;
      --muted:rgba(244,239,232,.74);
      --soft:rgba(244,239,232,.48);
      --gold:#b8925d;
      --gold-soft:rgba(184,146,93,.18);
    }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      margin:0;
      color:var(--text);
      background:
        radial-gradient(circle at 50% 0%, rgba(184,146,93,.18), transparent 24%),
        linear-gradient(180deg, #050505 0%, #090909 40%, #050505 100%);
      font-family: Georgia, "Times New Roman", serif;
    }
    a { color:inherit; text-decoration:none; }
    .wrap { max-width:1420px; margin:0 auto; }
    .topbar {
      position:sticky; top:0; z-index:30;
      display:flex; justify-content:space-between; align-items:center; gap:20px;
      padding:18px 22px;
      background:rgba(5,5,5,.78);
      backdrop-filter:blur(14px);
      border-bottom:1px solid var(--line-soft);
    }
    .brand-stack small {
      display:block;
      font-family: Arial, Helvetica, sans-serif;
      color:var(--soft);
      letter-spacing:.38em;
      font-size:10px;
      text-transform:uppercase;
      margin-bottom:4px;
    }
    .brand {
      font-size:24px;
      font-weight:700;
      letter-spacing:.14em;
      text-transform:uppercase;
    }
    .topmeta {
      font-family:Arial, Helvetica, sans-serif;
      font-size:13px;
      color:var(--muted);
    }
    .hero {
      padding:32px 18px 8px;
    }
    .intro {
      display:grid;
      grid-template-columns: 1.05fr .95fr;
      gap:26px;
      align-items:end;
      margin-bottom:26px;
    }
    .eyebrow {
      display:inline-block;
      font-family:Arial, Helvetica, sans-serif;
      text-transform:uppercase;
      letter-spacing:.34em;
      font-size:11px;
      color:var(--gold);
      margin-bottom:16px;
    }
    h1 {
      margin:0;
      font-size:clamp(36px, 6vw, 78px);
      line-height:1.02;
      font-weight:500;
    }
    .intro p {
      margin:18px 0 0;
      color:var(--muted);
      font-size:clamp(18px, 2vw, 26px);
      line-height:1.35;
    }
    .info-card {
      border:1px solid var(--line);
      background:linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      border-radius:30px;
      padding:24px;
      box-shadow:0 20px 80px rgba(0,0,0,.28);
    }
    .price {
      font-size:clamp(34px, 4vw, 52px);
      line-height:1;
      margin-bottom:14px;
    }
    .mini {
      font-family:Arial, Helvetica, sans-serif;
      color:var(--muted);
      line-height:1.8;
      font-size:15px;
    }
    .cta-row {
      margin-top:18px;
      display:flex;
      gap:12px;
      flex-wrap:wrap;
    }
    .btn {
      display:inline-flex; align-items:center; justify-content:center;
      min-height:48px;
      padding:12px 18px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.16);
      font-family:Arial, Helvetica, sans-serif;
      font-size:14px;
      transition:.22s ease;
      cursor:pointer;
      background:transparent;
      color:var(--text);
    }
    .btn:hover { transform:translateY(-1px); }
    .btn.primary {
      background:var(--text);
      color:#050505;
      border-color:var(--text);
      font-weight:700;
    }
    .btn.gold {
      background:rgba(184,146,93,.14);
      border-color:rgba(184,146,93,.55);
      color:var(--text);
    }

    .viewer {
      position:relative;
      overflow:hidden;
      border-top:1px solid rgba(184,146,93,.45);
      border-bottom:1px solid rgba(184,146,93,.18);
      background:#0a0a0a;
      box-shadow:0 18px 60px rgba(0,0,0,.22);
    }
    .main-image-wrap {
      position:relative;
      aspect-ratio:16/9;
      background:#101010;
      cursor:zoom-in;
    }
    .main-image {
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
    }
    .nav-btn {
      position:absolute; top:50%; transform:translateY(-50%);
      width:46px; height:46px; z-index:4;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.16);
      background:rgba(0,0,0,.34);
      backdrop-filter:blur(10px);
      color:#fff;
      font-size:22px;
      cursor:pointer;
    }
    .nav-btn.left { left:14px; }
    .nav-btn.right { right:14px; }
    .viewer-actions {
      position:absolute;
      left:18px; right:18px; bottom:16px;
      display:flex; justify-content:space-between; align-items:center; gap:14px;
      z-index:3;
    }
    .dots {
      display:flex; gap:9px; justify-content:center; align-items:center; flex:1;
    }
    .dot {
      width:10px; height:10px; border-radius:50%;
      background:rgba(255,255,255,.24);
      border:1px solid rgba(255,255,255,.10);
    }
    .dot.active { background:rgba(244,239,232,.95); }
    .all-photos {
      font-size:18px;
      border-bottom:1px solid rgba(255,255,255,.32);
      padding-bottom:4px;
      text-shadow:0 1px 8px rgba(0,0,0,.6);
    }
    .thumbs {
      display:grid;
      grid-template-columns: repeat(5, 1fr);
      gap:14px;
      padding:16px 0 0;
      background:linear-gradient(180deg, var(--gold-soft), transparent 72%);
    }
    .thumb {
      border:1px solid var(--line);
      background:#111;
      padding:0;
      cursor:pointer;
      overflow:hidden;
    }
    .thumb.active {
      border-color:rgba(184,146,93,.9);
      box-shadow:0 0 0 1px rgba(184,146,93,.6) inset;
    }
    .thumb img {
      width:100%;
      aspect-ratio:1.45/1;
      object-fit:cover;
      display:block;
    }

    .section {
      padding:60px 18px 90px;
      background:radial-gradient(circle at 50% 0%, rgba(184,146,93,.15), transparent 22%);
    }
    .label {
      font-size:14px;
      margin-bottom:18px;
    }
    .sep {
      height:1px;
      background:linear-gradient(90deg, rgba(184,146,93,.5), rgba(255,255,255,.06), rgba(255,255,255,0));
      margin-bottom:26px;
    }
    .spec-title {
      font-size:clamp(34px, 5vw, 66px);
      line-height:1.04;
      margin:0 0 24px;
      font-weight:500;
    }
    .specs {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:34px;
    }
    .spec-col {
      border-left:1px solid var(--line-soft);
      padding-left:28px;
    }
    .spec-col:first-child {
      border-left:none;
      padding-left:0;
    }
    .spec-row {
      display:flex;
      justify-content:space-between;
      gap:18px;
      padding:22px 0;
      border-bottom:1px solid var(--line-soft);
      font-size:22px;
    }
    .spec-row .k { color:var(--gold); }
    .spec-row .v {
      text-align:right;
      max-width:58%;
    }
    .note {
      margin-top:10px;
      color:var(--gold);
      font-size:16px;
      text-align:right;
    }

    .bottom-cta {
      margin-top:36px;
      padding:22px 0 0;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      flex-wrap:wrap;
      border-top:1px solid var(--line-soft);
      font-family:Arial, Helvetica, sans-serif;
      color:var(--muted);
    }

    .wa-float {
      position:fixed;
      right:18px; bottom:18px; z-index:40;
      display:inline-flex; align-items:center; gap:10px;
      padding:14px 18px;
      border-radius:999px;
      background:var(--text);
      color:#050505;
      font-family:Arial, Helvetica, sans-serif;
      font-weight:700;
      box-shadow:0 14px 40px rgba(0,0,0,.35);
    }

    .lightbox {
      position:fixed; inset:0; z-index:100;
      background:rgba(0,0,0,.96);
      display:none; flex-direction:column;
    }
    .lightbox.open { display:flex; }
    .lightbox-top {
      display:flex; justify-content:space-between; align-items:center; gap:16px;
      padding:16px 18px;
      border-bottom:1px solid rgba(255,255,255,.08);
      font-family:Arial, Helvetica, sans-serif;
      color:var(--muted);
    }
    .lightbox-controls {
      display:flex; gap:10px; align-items:center; flex-wrap:wrap;
    }
    .icon-btn {
      width:42px; height:42px; border-radius:999px;
      border:1px solid rgba(255,255,255,.16);
      background:rgba(255,255,255,.06);
      color:#fff; cursor:pointer; font-size:18px;
    }
    .lightbox-stage {
      flex:1;
      overflow:auto;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:20px;
    }
    .lightbox-stage img {
      max-width:100%;
      max-height:100%;
      transform-origin:center center;
      transition:transform .18s ease;
      user-select:none;
      -webkit-user-drag:none;
    }
    .hint {
      padding:12px 18px 18px;
      text-align:center;
      font-family:Arial, Helvetica, sans-serif;
      color:var(--soft);
      font-size:13px;
    }

    @media (max-width: 980px) {
      .intro, .specs { grid-template-columns:1fr; }
      .thumbs { grid-template-columns: repeat(3, 1fr); }
      .spec-col { border-left:none; padding-left:0; }
      .spec-row { font-size:18px; flex-direction:column; gap:8px; }
      .spec-row .v { text-align:left; max-width:100%; }
      .note { text-align:left; }
    }
    @media (max-width: 620px) {
      .brand { font-size:20px; }
      .topmeta { display:none; }
      .thumbs { grid-template-columns: repeat(2, 1fr); }
      .all-photos { font-size:16px; }
      .nav-btn { width:40px; height:40px; }
      .wa-float {
        right:12px; bottom:12px; padding:12px 16px; font-size:14px;
      }
    }
  </style>
</head>
<body>
  <div class="wrap">
