          </div>
        </div>
      </div>

      <div class="thumbs">
        
    <button class="thumb active" onclick="setSlide(0)" aria-label="Vista principal">
      <img src="data:image/jpeg;base64," alt="Vista principal">
    </button>
    

    <button class="thumb " onclick="setSlide(1)" aria-label="Traseira">
