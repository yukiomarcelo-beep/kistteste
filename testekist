    </button>
    

    <button class="thumb " onclick="setSlide(2)" aria-label="Cockpit em Alcântara">
      <img src="data:image/jpeg;base64," alt="Cockpit em Alcântara">
    </button>
    

    <button class="thumb " onclick="setSlide(3)" aria-label="Entrada de ar lateral">
      <img src="data:image/jpeg;base64," alt="Entrada de ar lateral">
