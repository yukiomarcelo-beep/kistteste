    </button>
    

    <button class="thumb " onclick="setSlide(5)" aria-label="Porta dihedral aberta">
      <img src="data:image/jpeg;base64," alt="Porta dihedral aberta">
    </button>
    
      </div>
    </section>

    <section class="section" id="detalhes">
      <div class="label">Detalhes Técnicos</div>
      <div class="sep"></div>
      <div class="spec-title">McLaren Artura 2026</div>

